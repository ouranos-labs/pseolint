{
  "name": "@pseolint/mcp",
  "version": "0.5.7",
  "description": "MCP server for pseolint — audit programmatic SEO sites from AI coding assistants. v0.5 adds the AI-orchestrated audit tool that produces a fix manifest with concrete patches.",
  "license": "MIT",
  "author": "Ouranos Labs <contact@ouranos-labs.dev>",
  "homepage": "https://pseolint.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ouranos-labs/pseolint.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "pseo",
    "spambrain",
    "lint",
    "ai"
  ],
  "type": "module",
  "bin": {
    "pseolint-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pseolint/core": "workspace:*",
    "zod": "^4.3.6"
  }
}
