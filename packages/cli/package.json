{
  "name": "pseolint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "pseolint": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
