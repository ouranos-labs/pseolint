# apps/web/.env.example
# Copy to apps/web/.env.local for dev; production values live in Vercel project env.

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
# Leave unset or use real OAuth credentials (omit lines entirely if unused).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=re_yourkey
# Before you verify a domain in Resend, use the shared sender below. With it,
# Resend only delivers to the email address that owns the Resend account —
# enough to sign yourself in. Switch to `pseolint <hello@pseolint.dev>` once
# the domain is verified so all users receive magic links.
RESEND_FROM=pseolint <onboarding@resend.dev>

# Non-empty placeholders so `next build` passes after `cp .env.example .env` — replace for real usage.
INNGEST_EVENT_KEY=local_dev_placeholder
INNGEST_SIGNING_KEY=signkey_local_dev_placeholder_32chars_xx

R2_ACCOUNT_ID=local_dev_placeholder
R2_ACCESS_KEY_ID=local_dev_placeholder
R2_SECRET_ACCESS_KEY=local_dev_placeholder
R2_BUCKET=pseolint-reports
# Optional public URL for R2; omit entirely or use a valid URL.
# R2_PUBLIC_BASE_URL=https://pub.example.com

POLAR_ACCESS_TOKEN=polar_local_dev_placeholder
POLAR_WEBHOOK_SECRET=polar_whsec_local_dev_placeholder
POLAR_MONTHLY_PRODUCT_ID=price_monthly_placeholder
POLAR_YEARLY_PRODUCT_ID=price_yearly_placeholder

# Cloudflare Turnstile — dev uses the official "always-pass" test keys.
# Swap for real keys from the Cloudflare dashboard in production.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

IP_HASH_SALT=generate_with_openssl_rand_base64_16

# Feature flags
# Direct Google Indexing API submission. Gated OFF ("Coming soon" in the UI):
# the API only crawls JobPosting/BroadcastEvent, and service-account → GSC
# onboarding is broken by a Google-side bug (since ~Apr 2026). IndexNow +
# sitemaps remain the supported path. Set to "true" to re-enable both the UI
# control and the server action.
# NEXT_PUBLIC_GOOGLE_INDEXING_ENABLED=false
