{
  "name": "@pseolint/action",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ncc": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.0",
    "@pseolint/core": "workspace:*"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4"
  }
}
