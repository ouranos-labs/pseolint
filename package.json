{
  "name": "pseolint-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "pSEO Lint monorepo",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=!@pseolint/web",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint:emdash": "node scripts/no-em-dash.mjs --check --diff",
    "gen:okf": "bun scripts/gen-okf.ts",
    "calibrate:intent": "bun scripts/calibrate-intent.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "gen:folklore": "bun scripts/gen-folklore-doc.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright-core": "^1.61.1",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@pseolint/web": "./apps/web",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "cheerio": "^1.2.0",
    "puppeteer-core": "^25.3.0"
  },
  "overrides": {
    "kysely": "^0.27.0"
  }
}
