{
  "name": "@pseolint/core",
  "version": "0.7.5",
  "description": "Programmatic SEO audit engine: 61 rules across 4 categories (integrity, discoverability, citation, data) for SpamBrain risk + AI Overview citability. Verdict ladder + site classifier.",
  "license": "MIT",
  "author": "Ouranos Labs <contact@ouranos-labs.dev>",
  "homepage": "https://pseolint.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ouranos-labs/pseolint.git",
    "directory": "packages/core"
  },
  "keywords": [
    "seo",
    "pseo",
    "programmatic-seo",
    "spambrain",
    "lint",
    "audit"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rules/tech/og-completeness": {
      "import": "./dist/rules/tech/og-completeness.js",
      "types": "./dist/rules/tech/og-completeness.d.ts"
    },
    "./rules/tech/soft-404": {
      "import": "./dist/rules/tech/soft-404.js",
      "types": "./dist/rules/tech/soft-404.d.ts"
    },
    "./rules/spam/thin-content": {
      "import": "./dist/rules/spam/thin-content.js",
      "types": "./dist/rules/spam/thin-content.d.ts"
    },
    "./rules/scope": {
      "import": "./dist/rules/scope.js",
      "types": "./dist/rules/scope.d.ts"
    },
    "./parser": {
      "import": "./dist/parser.js",
      "types": "./dist/parser.d.ts"
    },
    "./schemas/audit-summary.schema.json": "./schemas/audit-summary.schema.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-wikipedia-bloom": "bun run scripts/build-wikipedia-bloom.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests tests/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ai": "^5.0.0",
    "cheerio": "^1.2.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0",
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/mistral": "^2.0.0",
    "@ai-sdk/groq": "^2.0.0",
    "@ai-sdk/xai": "^2.0.0",
    "@ai-sdk/cohere": "^2.0.0",
    "ollama-ai-provider-v2": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/groq": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    },
    "@ai-sdk/cohere": {
      "optional": true
    },
    "ollama-ai-provider-v2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "ollama-ai-provider-v2": "^1.0.0"
  }
}